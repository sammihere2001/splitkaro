# Copy this file to .env and change the values.

# Default: a local SQLite file. To use MySQL instead (create the `splitkaro` database first):
# DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/splitkaro
DATABASE_URL=sqlite:///./splitkaro.db

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173
